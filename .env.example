# LLM API Keys (Free Tier Supported)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Provider Selection (groq | gemini | ollama | mock)
LLM_PROVIDER=groq

# Model Selection: Configure models directly from .env!
# Optional global override:
# LLM_MODEL=qwen/qwen3.8-27b
# Provider-specific models:
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_MODEL=llama3.1:8b

# Search API (Phase 3)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Persistence (Phase 4)
REDIS_URL=redis://localhost:6379/0

# Production Limits & Budgets
MAX_SUB_QUESTIONS=4
MAX_SEARCHES_PER_SUB_QUESTION=3
MAX_BUDGET_TOKENS=150000
MAX_WALL_CLOCK_SECONDS=240

# Logging & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
